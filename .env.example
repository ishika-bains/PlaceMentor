# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Leave empty or use localhost to automatically fall back to local JSON/in-memory storage if Mongo is not running)
MONGODB_URI=mongodb://localhost:27017/placementor

# JWT Secret for Authentication
JWT_SECRET=placementor_super_secret_jwt_key_2025_secure_dev

# JWT Expiration
JWT_EXPIRE=7d

# Google Gemini API Key for Real AI Mock Interview & AI Group Discussion
# Get a free key at: https://aistudio.google.com/
# If left empty, PlaceMentor automatically switches to its high-fidelity built-in Fallback AI engine!
GEMINI_API_KEY=

# Optional: Preferred Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
